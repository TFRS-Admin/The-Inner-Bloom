---
import { practice, bookingLinks } from "@/data/practice";
---

<section class="relative overflow-hidden">
  <div
    class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-bloom-200/50 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -left-32 top-1/2 h-80 w-80 rounded-full bg-sage-200/40 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto grid max-w-6xl gap-12 px-6 py-16 sm:py-24 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
    <div>
      <p class="mb-4 inline-flex items-center rounded-full bg-sage-100 px-4 py-1.5 text-sm font-medium text-sage-800">
        Telehealth psychiatry, Texas-wide
      </p>
      <h1 class="text-4xl font-medium leading-tight text-ink-900 sm:text-5xl">
        {practice.tagline}
      </h1>
      <p class="mt-6 max-w-xl text-lg text-ink-600">
        {practice.positioning} Visits with {practice.provider.fullTitle} are available in English and Spanish, {practice.hours.toLowerCase()}.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href={bookingLinks.insurance.href}
          class="rounded-full bg-sage-700 px-6 py-3 text-base font-semibold text-white shadow-sm transition hover:bg-sage-800"
        >
          Book with insurance
        </a>
        <a
          href={bookingLinks.selfPay.href}
          class="rounded-full border border-sage-700 px-6 py-3 text-base font-semibold text-sage-800 transition hover:bg-sage-50"
        >
          Book self-pay
        </a>
      </div>
      <p class="mt-4 text-sm text-ink-500">
        Prefer to talk first? Call or text <a class="underline hover:text-sage-700" href={practice.contact.phoneHref}>{practice.contact.phone}</a>.
      </p>
    </div>

    <div class="relative mx-auto w-full max-w-sm">
      <div class="overflow-hidden rounded-[2rem] border-4 border-white bg-bloom-100 shadow-xl">
        <img
          src="/images/marie-newball.jpg"
          alt={`${practice.provider.fullTitle}, provider at ${practice.name}`}
          width="387"
          height="419"
          class="h-full w-full object-cover"
          loading="eager"
        />
      </div>
      <p class="mt-3 text-center text-sm font-medium text-ink-600">{practice.provider.fullTitle}</p>
    </div>
  </div>
</section>
