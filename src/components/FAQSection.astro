---
import { faqs } from "@/data/practice";
---

<section id="faq" class="bg-white py-20">
  <div class="mx-auto max-w-3xl px-6">
    <h2 class="text-3xl font-medium text-ink-900 sm:text-4xl">Frequently asked questions</h2>
    <p class="mt-4 text-lg text-ink-600">
      Straight answers about booking, insurance, and what to expect.
    </p>

    <div class="mt-10 divide-y divide-bloom-200">
      {
        faqs.map((faq) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-lg font-medium text-ink-900 marker:content-none">
              {faq.question}
              <span
                aria-hidden="true"
                class="flex-none rounded-full border border-bloom-300 px-2 py-0.5 text-sm text-sage-700 transition group-open:rotate-45"
              >
                +
              </span>
            </summary>
            <p class="mt-3 text-ink-600">{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
