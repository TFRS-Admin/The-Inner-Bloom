---
import { practice } from "@/data/practice";

const items = [
  { label: "Modality", value: practice.modality },
  { label: "Coverage area", value: practice.geography },
  { label: "Languages", value: practice.languages.join(" & ") },
  { label: "Hours", value: practice.hours },
];
---

<section class="border-y border-bloom-200/70 bg-white/60">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-6 px-6 py-8 text-center sm:grid-cols-4">
    {
      items.map((item) => (
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-sage-700">{item.label}</dt>
          <dd class="mt-1 text-sm font-medium text-ink-800">{item.value}</dd>
        </div>
      ))
    }
  </div>
</section>
