---
import { practice, bookingLinks } from "@/data/practice";

const year = 2026;
---

<footer id="contact" class="mt-20 bg-ink-900 text-bloom-50">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="font-display text-xl font-medium text-white">{practice.name}</p>
        <p class="mt-3 text-sm text-bloom-200">{practice.provider.fullTitle}</p>
        <p class="mt-1 text-sm text-bloom-300">NPI {practice.provider.npi}</p>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-bloom-300">Contact</p>
        <ul class="mt-3 space-y-2 text-sm text-bloom-100">
          <li><a class="hover:text-white" href={practice.contact.phoneHref}>{practice.contact.phone}</a></li>
          <li><a class="hover:text-white" href={`mailto:${practice.contact.email}`}>{practice.contact.email}</a></li>
          <li>Referral fax: {practice.contact.fax}</li>
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-bloom-300">Hours</p>
        <p class="mt-3 text-sm text-bloom-100">{practice.hours}</p>
        <p class="mt-1 text-sm text-bloom-100">{practice.geography}</p>
        <p class="mt-1 text-sm text-bloom-100">{practice.languages.join(" & ")}</p>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-bloom-300">Book an appointment</p>
        <div class="mt-3 flex flex-col gap-3">
          <a
            href={bookingLinks.insurance.href}
            class="rounded-full bg-sage-600 px-5 py-2.5 text-center text-sm font-semibold text-white transition hover:bg-sage-500"
          >
            Insurance (Headway)
          </a>
          <a
            href={bookingLinks.selfPay.href}
            class="rounded-full border border-bloom-300 px-5 py-2.5 text-center text-sm font-semibold text-bloom-50 transition hover:border-white"
          >
            Self-pay (SimplePractice)
          </a>
        </div>
      </div>
    </div>

    <div class="mt-12 border-t border-white/10 pt-6 text-xs text-bloom-300">
      <p>
        &copy; {year} {practice.name}. This site is for general information only and does not
        constitute medical advice or create a provider-patient relationship.
      </p>
    </div>
  </div>
</footer>
