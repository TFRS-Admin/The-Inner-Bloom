---
import { practice } from "@/data/practice";
---

<section id="services" class="mx-auto max-w-6xl px-6 py-20">
  <div class="max-w-2xl">
    <h2 class="text-3xl font-medium text-ink-900 sm:text-4xl">Services</h2>
    <p class="mt-4 text-lg text-ink-600">
      Focused psychiatric care, built around evaluation and medication management — delivered entirely by telehealth.
    </p>
  </div>

  <div class="mt-12 grid gap-6 sm:grid-cols-3">
    {
      practice.services.map((service) => (
        <div class="rounded-2xl border border-bloom-200 bg-white p-6 shadow-sm">
          <h3 class="text-xl font-medium text-ink-900">{service.title}</h3>
          <p class="mt-3 text-ink-600">{service.description}</p>
        </div>
      ))
    }
  </div>

  <div class="mt-12 rounded-2xl bg-sage-50 p-8">
    <h3 class="text-lg font-semibold text-sage-900">Who we treat</h3>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        practice.ages.map((age) => (
          <div class="rounded-xl bg-white px-4 py-3 text-center shadow-sm">
            <p class="font-medium text-ink-900">{age.label}</p>
            <p class="text-sm text-ink-500">{age.detail}</p>
          </div>
        ))
      }
    </div>

    <h3 class="mt-8 text-lg font-semibold text-sage-900">Focus areas</h3>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        practice.focusAreas.map((area) => (
          <li class="rounded-full bg-white px-4 py-1.5 text-sm font-medium text-ink-700 shadow-sm">{area}</li>
        ))
      }
    </ul>
  </div>
</section>
